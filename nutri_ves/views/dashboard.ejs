<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nutri VES - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <a href="/dashboard" class="nav-brand">Nutri VES</a>
      <div class="nav-links">
        <a href="/dashboard" class="nav-link">Pacientes</a>
        <a href="/register" class="nav-link">Registrar Paciente</a>
        <span class="nav-user"><%= nutriologo %></span>
        <a href="/logout" class="nav-link nav-logout">Cerrar Sesión</a>
      </div>
    </div>
  </nav>
  <main class="container">
    <div class="dashboard-header">
      <h1>Pacientes Registrados</h1>
      <a href="/register" class="btn btn-primary">+ Nuevo Paciente</a>
    </div>
    <% if (patients.length) { %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th><th>Nombre</th><th>Edad</th><th>Peso (kg)</th>
            <th>Altura (cm)</th><th>IMC</th><th>Diagnóstico</th><th>Registrado</th><th>Acción</th>
          </tr>
        </thead>
        <tbody id="patientsBody">
          <% patients.forEach(p => { %>
          <tr data-patient-id="<%= p.id %>">
            <td><%= p.id %></td>
            <td class="cell-name"><%= p.name %></td>
            <td class="cell-age"><%= p.age %></td>
            <td class="cell-weight"><%= p.weight %></td>
            <td class="cell-height"><%= p.height %></td>
            <td class="cell-bmi"><strong><%= p.bmi %></strong></td>
            <td class="cell-diagnosis">
              <span class="diagnosis diagnosis-<%= p.diagnosis === 'Bajo Peso' ? 'bajo' : p.diagnosis === 'Peso Normal' ? 'normal' : p.diagnosis === 'Sobrepeso' ? 'sobre' : 'obesidad' %>"><%= p.diagnosis %></span>
            </td>
            <td><%= p.created_at.slice(0,10) %></td>
            <td class="cell-actions">
              <button class="btn btn-sm btn-secondary btn-edit" data-id="<%= p.id %>">Editar</button>
              <a href="/patient/<%= p.id %>" class="btn btn-sm btn-secondary">Consultar</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">
      <p>No hay pacientes registrados aún.</p>
      <a href="/register" class="btn btn-primary">Registrar Primer Paciente</a>
    </div>
    <% } %>
  </main>

  <div id="editModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h2>Editar Paciente</h2>
        <span class="modal-close">&times;</span>
      </div>
      <form id="editForm">
        <input type="hidden" id="editId" name="id">
        <div class="form-group">
          <label for="editName">Nombre Completo</label>
          <input type="text" id="editName" name="name" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="editWeight">Peso (kg)</label>
            <input type="number" id="editWeight" name="weight" step="0.1" min="1" max="500" required>
          </div>
          <div class="form-group">
            <label for="editHeight">Altura (cm)</label>
            <input type="number" id="editHeight" name="height" step="0.1" min="50" max="250" required>
          </div>
          <div class="form-group">
            <label for="editAge">Edad</label>
            <input type="number" id="editAge" name="age" min="0" max="150" required>
          </div>
        </div>
        <div class="bmi-preview" id="editBmiPreview" style="display:none;">
          <div class="bmi-value">IMC: <span id="editBmiValue">--</span></div>
          <div class="bmi-diagnosis">Diagnóstico: <span id="editBmiDiagnosis">--</span></div>
        </div>
        <div id="editError" class="error-msg" style="display:none;"></div>
        <button type="submit" class="btn btn-primary btn-full" id="editSubmitBtn">Guardar Cambios</button>
      </form>
    </div>
  </div>

  <script>
    (function() {
      const modal = document.getElementById('editModal');
      const closeBtn = document.querySelector('.modal-close');
      const editForm = document.getElementById('editForm');
      const editError = document.getElementById('editError');

      const eId = document.getElementById('editId');
      const eName = document.getElementById('editName');
      const eWeight = document.getElementById('editWeight');
      const eHeight = document.getElementById('editHeight');
      const eAge = document.getElementById('editAge');

      const eBmiPreview = document.getElementById('editBmiPreview');
      const eBmiVal = document.getElementById('editBmiValue');
      const eBmiDiag = document.getElementById('editBmiDiagnosis');

      function calcBMI(w, h) {
        if (w > 0 && h > 0) { const m = h / 100; return Math.round((w / (m * m)) * 100) / 100; }
        return null;
      }
      function diag(b) {
        if (b === null) return '--';
        if (b < 18.5) return 'Bajo Peso';
        if (b < 25) return 'Peso Normal';
        if (b < 30) return 'Sobrepeso';
        return 'Obesidad';
      }
      function updateBmiPreview() {
        const b = calcBMI(parseFloat(eWeight.value), parseFloat(eHeight.value));
        if (b !== null) {
          eBmiPreview.style.display = 'flex';
          eBmiVal.textContent = b;
          eBmiDiag.textContent = diag(b);
        } else {
          eBmiPreview.style.display = 'none';
        }
      }
      eWeight.addEventListener('input', updateBmiPreview);
      eHeight.addEventListener('input', updateBmiPreview);

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', function() {
          const row = this.closest('tr');
          eId.value = this.dataset.id;
          eName.value = row.querySelector('.cell-name').textContent.trim();
          eWeight.value = row.querySelector('.cell-weight').textContent.trim();
          eHeight.value = row.querySelector('.cell-height').textContent.trim();
          eAge.value = row.querySelector('.cell-age').textContent.trim();
          editError.style.display = 'none';
          modal.style.display = 'flex';
          updateBmiPreview();
        });
      });

      function closeModal() { modal.style.display = 'none'; editError.style.display = 'none'; }
      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) { if (e.target === this) closeModal(); });

      editForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const fd = new FormData(this);
        editError.style.display = 'none';
        document.getElementById('editSubmitBtn').textContent = 'Guardando...';
        document.getElementById('editSubmitBtn').disabled = true;

        const params = new URLSearchParams(fd);
        fetch('/patient/' + eId.value + '/edit', { method: 'POST', body: params })
          .then(r => r.json())
          .then(data => {
            if (data.success) {
              const row = document.querySelector('tr[data-patient-id="' + data.patient.id + '"]');
              row.querySelector('.cell-name').textContent = data.patient.name;
              row.querySelector('.cell-age').textContent = data.patient.age;
              row.querySelector('.cell-weight').textContent = data.patient.weight;
              row.querySelector('.cell-height').textContent = data.patient.height;
              row.querySelector('.cell-bmi').innerHTML = '<strong>' + data.patient.bmi + '</strong>';

              const dCell = row.querySelector('.cell-diagnosis');
              const dClass = data.patient.diagnosis === 'Bajo Peso' ? 'bajo'
                : data.patient.diagnosis === 'Peso Normal' ? 'normal'
                : data.patient.diagnosis === 'Sobrepeso' ? 'sobre' : 'obesidad';
              dCell.innerHTML = '<span class="diagnosis diagnosis-' + dClass + '">' + data.patient.diagnosis + '</span>';

              document.getElementById('editSubmitBtn').textContent = 'Guardar Cambios';
              document.getElementById('editSubmitBtn').disabled = false;
              closeModal();
            } else {
              editError.textContent = data.error || 'Error al guardar';
              editError.style.display = 'block';
              document.getElementById('editSubmitBtn').textContent = 'Guardar Cambios';
              document.getElementById('editSubmitBtn').disabled = false;
            }
          })
          .catch(function() {
            editError.textContent = 'Error de conexión con el servidor';
            editError.style.display = 'block';
            document.getElementById('editSubmitBtn').textContent = 'Guardar Cambios';
            document.getElementById('editSubmitBtn').disabled = false;
          });
      });
    })();
  </script>
</body>
</html>
